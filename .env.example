# SPL-16
PORT=8792
SITE_URL=http://localhost:8792
DATA_DIR=./data
HELIUS_API_KEY=
SOLANA_RPC_URL=
# the launchpad wallet: receives the partner share of fees on every coin (feeClaimer) and leftovers
HOUSE_WALLET=
HOUSE_WALLET_SECRET=
# optional: pin coin icons/metadata to IPFS instead of serving from SITE_URL/a/
ASSET_STORE=
PINATA_JWT=
PINATA_GATEWAY=
# canvas scale: price at the bottom / top of the canvas, as market cap in SOL
START_MCAP_SOL=28
MAX_MCAP_SOL=400
# platform token mint, once launched
PLATFORM_MINT=
X_URL=https://x.com/splsixteen
# DRY_RUN=1 fakes launches locally
# wallets allowed to launch the reserved SPL-16 / $SPL name (comma-separated; HOUSE_WALLET is always allowed)
OFFICIAL_WALLETS=
HOLDER_MIN_TOKENS=1000000
